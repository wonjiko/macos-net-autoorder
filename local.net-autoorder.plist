<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.net-autoorder</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/net-autoorder.sh</string>
	</array>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/log/net-autoorder.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/net-autoorder.log</string>
</dict>
</plist>
